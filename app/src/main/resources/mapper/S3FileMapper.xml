<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.app.mapper.S3FileMapper">
  <resultMap id="s3FileResultMap" type="com.example.app.dto.S3FileDto">
    <result property="id" column="id"/>
    <result property="entityType" column="entity_type"/>
    <result property="entityId" column="entity_id"/>
    <result property="s3Path" column="s3_path"/>
    <result property="createdAt" column="created_at"/>
    <result property="updatedAt" column="updated_at"/>
  </resultMap>

  <select id="getS3FilePathByEntityTypeAndId" resultType="String">
    SELECT s3_path
    FROM S3_FILES
    where
      entity_type = #{entityType.value}
      AND entity_id = #{entityId}
      AND del_flg = false
    ORDER BY id
  </select>

  <insert id="insertS3File" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO S3_FILES (entity_type, entity_id, s3_path)
    VALUES (#{entityType.value}, #{entityId}, #{s3Path})
  </insert>

</mapper>

